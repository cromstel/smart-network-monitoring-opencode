# dependencies
node_modules/

# next.js
.next/
out/

# build artifacts
*.tsbuildinfo
next-env.d.ts.orig

# environment — never commit secrets; .env.example is the template.
# Use `.env*` (glob) not `.env.*` (literal dot): a file named ".env local"
# with a space was committed to git under the old rule and leaked a DB password.
.env*
!.env.example

# local data (SQLite dev database and seed data)
data/
*.db
*.db-journal

# testing
coverage/
playwright-report/
test-results/

# logs
*.log
npm-debug.log*

# project documentation — kept locally, deliberately untracked.
# The perf and soak harnesses still write doc/PERFORMANCE.md and doc/SOAK.md,
# and CI publishes them as artifacts, but the markdown itself is not versioned.
# Anchored with a leading slash so a nested doc/ elsewhere is unaffected.
/doc/
