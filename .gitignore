# dependencies
node_modules/

# next.js
.next/
out/

# build artifacts
*.tsbuildinfo
next-env.d.ts.orig

# environment — never commit secrets; .env.example is the template.
# Use `.env*` (glob) not `.env.*` (literal dot): a file named ".env local"
# with a space was committed to git under the old rule and leaked a DB password.
.env*
!.env.example

# local data (SQLite dev database and seed data)
data/
*.db
*.db-journal

# testing
coverage/
playwright-report/
test-results/

# Test sources — deliberately untracked.
#
# The rule is that test code must never reach the remote repository or a
# production image: it is not part of the shipped product, it inflates every
# clone and every container layer, and it is the one part of the tree that
# documents internals rather than behaviour.
#
# The files stay on the developer's disk so the suite can still be run
# locally; they are simply not versioned and not shipped. `npm run
# test:purge` deletes them from the working tree once testing is done, and
# `npm run test:clean` removes the artefacts a test run leaves behind.
#
# `__tests__/` is matched by name, so a directory of that name anywhere in the
# tree is ignored, not just the one under lib/.
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/

# logs
*.log
npm-debug.log*

# project documentation — kept locally, deliberately untracked.
# The perf and soak harnesses still write doc/PERFORMANCE.md and doc/SOAK.md,
# and CI publishes them as artifacts, but the markdown itself is not versioned.
# Anchored with a leading slash so a nested doc/ elsewhere is unaffected.
/doc/

# review reports — local-only, deliberately untracked, same rationale as /doc/.
# These name file:line findings against a moving tree and go stale the moment
# the code they describe is edited.
# Anchored with a leading slash so a nested thoughts/ elsewhere is unaffected.
/thoughts/
