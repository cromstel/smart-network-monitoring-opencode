{
  "name": "home-network-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted dashboard that discovers and monitors every device on a local network",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "ts-node --project tsconfig.node.json lib/db/migrate.ts",
    "db:migrate:down": "ts-node --project tsconfig.node.json lib/db/migrate.ts --down",
    "db:seed": "ts-node --project tsconfig.node.json scripts/seed.ts",
    "db:seed:e2e": "cross-env DB_FILE=./data/e2e.db ts-node --project tsconfig.node.json scripts/e2e-seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run type-check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-table": "^9.2.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.28.17",
    "lucide-react": "^1.48.0",
    "mysql2": "^3.24.4",
    "next": "^15.1.0",
    "node-cron": "^4.2.1",
    "oui-data": "^1.2.0",
    "pino": "^9.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "//overrides": [
    "Next 15.5.26 pins postcss 8.4.31, which lands a nested copy that npm audit",
    "flags as high severity (XSS via unescaped </style> in stringify output, plus",
    "an arbitrary-file-read issue). The root already resolves 8.5.28, so the",
    "nested copy is pure duplication. Overriding it clears both advisories",
    "without waiting for a Next major, and the build plus the full suite are",
    "verified against the result."
  ],
  "overrides": {
    "postcss": "^8.5.28"
  }
}
