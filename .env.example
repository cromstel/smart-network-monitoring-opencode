# =============================================================================
# App Config
# =============================================================================
NODE_ENV=development
PORT=9000
LOG_LEVEL=debug
# Shown in the browser tab, the sidebar and the sign-in page. Required â€” a
# deployment that forgets it would otherwise advertise another product's name.
# Set per environment; changing it needs no rebuild.
APP_NAME="Home Network Monitor"
# =============================================================================
# Database â€” 'sqlite' (development) or 'mysql' (production)
# =============================================================================
DB_CLIENT=sqlite
DB_FILE=./data/dev.db

# =============================================================================
# MySQL â€” required when DB_CLIENT=mysql
# =============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
# Required by docker-compose when starting the local MySQL. There is no
# default on purpose. Leave blank when running on SQLite.
DB_PASSWORD=
# docker-compose also requires this for the MySQL root account.
DB_ROOT_PASSWORD=

# =============================================================================
# Security â€” generate with: openssl rand -hex 32
# =============================================================================
SESSION_SECRET=
ENCRYPTION_KEY=

# =============================================================================
# Network
# =============================================================================
NETWORK_SUBNET=192.168.1.0/24
SCANNER_MODE=simulated
SCAN_INTERVAL_SECONDS=30
