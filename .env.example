# =============================================================================
# App Config
# =============================================================================
NODE_ENV=development
PORT=9090
LOG_LEVEL=debug
# Shown in the browser tab, the sidebar and the sign-in page. Required — a
# deployment that forgets it would otherwise advertise another product's name.
# Set per environment; changing it needs no rebuild.
APP_NAME="Home Network Monitor"
# =============================================================================
# Database - MySQL/MariaDB. The app is MySQL-only: Kysely's MysqlDialect over
# mysql2, reaching whichever server the variables below name.
# =============================================================================
# Optional: only 'mysql' is accepted, and it is the default. It names the
# driver and dialect, not the server - MariaDB speaks the same protocol.
# DB_CLIENT=mysql

# Connection identity. Required together: a schema name and an account are
# configuration the operator owns, so neither is defaulted.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=home_monitor
DB_USER=monitor
DB_PASSWORD=
# docker-compose also requires this for the MySQL root account.
DB_ROOT_PASSWORD=

# =============================================================================
# Security — generate with: openssl rand -hex 32
# =============================================================================
SESSION_SECRET=
ENCRYPTION_KEY=

# =============================================================================
# Network
# =============================================================================
NETWORK_SUBNET=192.168.1.0/24
SCANNER_MODE=simulated
SCAN_INTERVAL_SECONDS=30
